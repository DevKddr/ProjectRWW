# ------------------------------------------
# Build Configuration Exceptions
# ------------------------------------------

# Allow Build configuration files
!Build/*/

# Ignore everything under Build
Build/*/**

# Except PakBlacklist files
!Build/*/PakBlacklist*.txt

# Don't ignore icons
!Build/**/*.ico


